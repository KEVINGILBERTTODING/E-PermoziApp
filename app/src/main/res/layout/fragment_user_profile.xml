<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingTop="16dp"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    tools:context=".presentation.user.profile.ui.UserProfileFragment">
    <TextView
        android:layout_width="wrap_content"
        android:textSize="25sp"
        android:textColor="@color/black"
        android:text="@string/profile"
        android:fontFamily="@font/satoshi_bold"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginTop="18dp"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:id="@+id/rlPhoto"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/progressBarPhoto"
                android:layout_centerInParent="true"
                android:layout_width="24dp"
                android:indeterminateTint="@color/main"
                android:layout_height="24dp"/>
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivProfile"
                android:layout_marginRight="10dp"
                android:layout_width="80dp"
                android:layout_alignParentStart="true"
                android:layout_height="80dp"/>
        </RelativeLayout>


        <LinearLayout
            android:layout_toRightOf="@id/rlPhoto"
            android:layout_width="match_parent"
            android:layout_centerVertical="true"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tvTotalProcess"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="@string/process"
                        android:fontFamily="@font/satoshi_regular"
                        android:layout_width="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tvTotalSuccess"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="@string/success"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/satoshi_regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tvTotalFailed"
                        android:fontFamily="@font/satoshi_medium"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:text="@string/failed"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/satoshi_regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>


            </LinearLayout>

        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/tvFullname"
            android:layout_width="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:fontFamily="@font/satoshi_bold"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_marginTop="3dp"
            android:id="@+id/tvEmail"
            android:visibility="gone"
            android:textSize="12sp"
            android:textColor="@color/black"
            android:fontFamily="@font/satoshi_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProfile"
                android:layout_width="0dp"
                app:cornerRadius="8dp"
                android:textSize="14sp"
                app:backgroundTint="@color/gray_eb"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:fontFamily="@font/satoshi_bold"
                android:layout_marginRight="18dp"
                android:layout_height="wrap_content"
                android:text="@string/ubah_profil"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogOut"
                android:layout_width="0dp"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/red_e2"
                android:textColor="@color/red_1b"
                android:fontFamily="@font/satoshi_bold"
                android:textSize="14sp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/keluar"/>
        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            app:tabBackground="@color/bg"
            app:tabGravity="fill"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorColor="@color/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>


    </LinearLayout>

</LinearLayout>