<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="@color/main"
    android:layout_height="match_parent"
    tools:context=".presentation.admin_employee.profile.ui.AeProfileActivity">

    <RelativeLayout
        android:layout_marginTop="120dp"
        android:background="@drawable/bottom_sheet_bg_gray"
        android:layout_width="match_parent"
        android:padding="16dp"
        android:layout_alignParentTop="true"
        android:layout_height="match_parent">

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            app:cornerRadius="8dp"
            android:layout_height="wrap_content"
            android:id="@+id/btnEdit"
            android:textColor="@color/main"
            android:layout_alignParentEnd="true"
            android:backgroundTint="@color/blue_ff"
            android:text="@string/ubah_profil"
            android:fontFamily="@font/satoshi_bold"
            android:textSize="14sp"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/lrBack"
        android:foreground="?android:selectableItemBackground"
        android:layout_marginStart="16dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="16dp"
        android:orientation="vertical">
        <include
            layout="@layout/button_back_layout"/>
    </LinearLayout>


    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ivProfile"
        android:layout_below="@+id/lrBack"
        android:layout_width="90dp"
        app:civ_border_width="3dp"
        android:layout_marginStart="16dp"
        android:layout_alignParentStart="true"
        android:src="@color/bg"
        android:layout_marginTop="20dp"
        app:civ_border_color="@color/bg"
        android:layout_height="90dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ivProfile"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:id="@+id/skeletonUsername"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/gray_e1"
                android:layout_height="wrap_content">
                <TextView
                    android:text="Jhon Doe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/satoshi_bold"
                    android:textColor="@color/gray_e1"
                    android:textSize="16sp" />
            </androidx.cardview.widget.CardView>
        </com.facebook.shimmer.ShimmerFrameLayout>


        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:id="@+id/skeletonEmail"
            android:layout_height="wrap_content">
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:layout_marginTop="5dp"
                app:cardBackgroundColor="@color/gray_e1"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="jhondoe@gmail.com"
                    android:fontFamily="@font/satoshi_regular"
                    android:textColor="@color/gray_e1"
                    android:textSize="12sp" />
            </androidx.cardview.widget.CardView>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/satoshi_bold"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/satoshi_regular"
            android:textColor="@color/black"
            android:textSize="12sp" />

    </LinearLayout>
    <Button
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:id="@+id/btnLogOut"
        android:layout_marginHorizontal="16dp"
        android:textColor="@color/red_1b"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/red_e2"
        android:text="@string/keluar"
        android:fontFamily="@font/satoshi_bold"
        android:textSize="16sp"/>
</RelativeLayout>