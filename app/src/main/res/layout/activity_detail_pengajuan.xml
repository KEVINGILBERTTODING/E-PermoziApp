<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:background="@color/bg"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    tools:context=".presentation.user.Pengajuan.ui.DetailPengajuanActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <include android:id="@+id/btnBack"
            layout="@layout/button_back"/>

        <RelativeLayout
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_toLeftOf="@id/rlAction"
                android:layout_alignParentStart="true"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:id="@+id/tvHeader"
                    android:fontFamily="@font/satoshi_bold"
                    android:layout_height="wrap_content"/>

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:id="@+id/skeletonHeader"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">
                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/gray_e1"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Perizinan mendirikan menara"
                                android:fontFamily="@font/satoshi_medium"
                                android:textColor="@color/gray_e1"
                                android:textSize="14sp"/>
                        </androidx.cardview.widget.CardView>
                        <androidx.cardview.widget.CardView
                            android:layout_width="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            android:layout_marginTop="10dp"
                            app:cardBackgroundColor="@color/gray_e1"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Process 22 juni 2022"
                                android:fontFamily="@font/satoshi_medium"
                                android:textColor="@color/gray_e1"
                                android:textSize="12sp"/>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:textSize="14sp"
                    android:layout_marginTop="5dp"
                    android:id="@+id/tvTitle"
                    android:textColor="@color/black"
                    android:fontFamily="@font/satoshi_medium"
                    android:layout_height="wrap_content"/>

                <RelativeLayout
                    android:id="@+id/rlStatusTimeStamp"
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        app:cardElevation="0dp"
                        app:contentPaddingTop="4dp"
                        android:id="@+id/cvStatus"
                        app:contentPaddingBottom="4dp"
                        app:contentPaddingRight="12dp"
                        app:contentPaddingLeft="12dp"
                        app:cardCornerRadius="8dp"
                        android:layout_alignParentStart="true"
                        app:cardBackgroundColor="@color/blue_ff"
                        android:layout_width="wrap_content"
                        android:layout_marginRight="10dp"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status"
                            android:fontFamily="@font/satoshi_medium"
                            android:textSize="14sp"/>
                    </androidx.cardview.widget.CardView>
                    <TextView
                        android:id="@+id/tvTimeStamp"
                        android:textSize="10sp"
                        android:layout_centerInParent="true"
                        android:layout_toRightOf="@+id/cvStatus"
                        android:textColor="@color/black"
                        android:fontFamily="@font/satoshi_regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </RelativeLayout>


            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/rlAction"
                android:layout_marginLeft="20dp"
                android:layout_alignParentEnd="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:id="@+id/cvInfo"
                    app:cardBackgroundColor="@color/blue_ff"
                    android:layout_height="wrap_content"
                    app:contentPadding="8dp"
                    android:foreground="?android:selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:src="@drawable/ic_info"
                        android:layout_width="24dp"
                        android:tint="@color/main"
                        android:layout_gravity="center"
                        android:layout_height="24dp"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:id="@+id/cvDelete"
                    android:layout_marginLeft="20dp"
                    app:cardBackgroundColor="@color/red_e2"
                    android:layout_height="wrap_content"
                    app:contentPadding="8dp"
                    android:foreground="?android:selectableItemBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <ProgressBar
                        android:id="@+id/progressBarDelete"
                        android:layout_width="24dp"
                        android:indeterminateTint="@color/red_1b"
                        android:layout_gravity="center"
                        android:layout_height="24dp"/>
                    <ImageView
                        android:id="@+id/btnDelete"
                        android:src="@drawable/ic_trash"
                        android:layout_width="24dp"
                        android:tint="@color/red_1b"
                        android:layout_gravity="center"
                        android:layout_height="24dp"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>



        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <FrameLayout
                            android:id="@+id/frameSkeleton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <include
                                layout="@layout/item_persyaratan_skeleton"/>
                        </FrameLayout>
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvPersyaratan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <RelativeLayout
                            android:id="@+id/rlButtonSubmit"
                            android:layout_width="match_parent"
                            android:layout_marginTop="30dp"
                            android:layout_marginBottom="16dp"
                            android:gravity="bottom"
                            android:layout_height="wrap_content">
                            <ProgressBar
                                android:layout_width="24dp"
                                android:indeterminateTint="@color/main"
                                android:id="@+id/progressBarSubmit"
                                android:visibility="gone"
                                android:layout_centerInParent="true"
                                android:layout_height="24dp"/>

                            <com.google.android.material.button.MaterialButton
                                android:layout_width="match_parent"
                                android:id="@+id/btnSubmit"
                                android:textSize="16sp"
                                android:textColor="@color/white"
                                android:fontFamily="@font/satoshi_bold"
                                android:layout_height="56dp"
                                android:text="@string/simpan"/>

                        </RelativeLayout>
                    </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </LinearLayout>


    <include
        android:id="@+id/lrEmptyView"
        layout="@layout/empty_state_layout"/>
    <include
        android:id="@+id/lrErrorView"
        layout="@layout/error_state_layout"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_width="wrap_content"
        android:layout_marginBottom="20dp"
        app:tint="@color/white"
        android:id="@+id/fabMessage"
        app:elevation="0dp"
        app:backgroundTint="@color/main"
        android:src="@drawable/ic_message"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_height="wrap_content"/>


</RelativeLayout>