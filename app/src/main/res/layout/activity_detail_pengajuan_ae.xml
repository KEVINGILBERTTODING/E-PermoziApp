<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:background="@color/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    tools:context=".presentation.user.Pengajuan.ui.DetailPengajuanActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_above="@id/lrBottom"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/lrBack"
            android:foreground="?android:selectableItemBackground"
            android:layout_marginStart="16dp"
            android:layout_alignParentTop="true"
            android:layout_marginTop="16dp"
            android:orientation="vertical">
            <include
                layout="@layout/button_back_layout"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="1dp"
            android:background="@drawable/bottom_sheet_bg_gray"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:paddingTop="16dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_toLeftOf="@id/rlAction"
                            android:layout_alignParentStart="true"
                            android:layout_marginRight="20dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.facebook.shimmer.ShimmerFrameLayout
                                android:layout_width="match_parent"
                                android:id="@+id/skeletonHeader"
                                android:layout_height="wrap_content">
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:orientation="vertical"
                                    android:layout_height="wrap_content">
                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        app:cardCornerRadius="12dp"
                                        app:cardElevation="0dp"
                                        app:cardBackgroundColor="@color/gray_e1"
                                        android:layout_height="wrap_content">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Perizinan mendirikan menara"
                                            android:fontFamily="@font/satoshi_medium"
                                            android:textColor="@color/gray_e1"
                                            android:textSize="16sp"/>
                                    </androidx.cardview.widget.CardView>
                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        app:cardCornerRadius="12dp"
                                        app:cardElevation="0dp"
                                        android:layout_marginTop="10dp"
                                        app:cardBackgroundColor="@color/gray_e1"
                                        android:layout_height="wrap_content">
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Process 22 juni 2022"
                                            android:fontFamily="@font/satoshi_medium"
                                            android:textColor="@color/gray_e1"
                                            android:textSize="12sp"/>
                                    </androidx.cardview.widget.CardView>
                                </LinearLayout>
                            </com.facebook.shimmer.ShimmerFrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:textSize="16sp"
                                android:id="@+id/tvTitle"
                                android:textColor="@color/black"
                                android:fontFamily="@font/satoshi_medium"
                                android:layout_height="wrap_content"/>

                            <RelativeLayout
                                android:id="@+id/rlStatusTimeStamp"
                                android:layout_marginTop="10dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <androidx.cardview.widget.CardView
                                    app:cardElevation="0dp"
                                    app:contentPaddingTop="4dp"
                                    android:id="@+id/cvStatus"
                                    app:contentPaddingBottom="4dp"
                                    app:contentPaddingRight="12dp"
                                    app:contentPaddingLeft="12dp"
                                    app:cardCornerRadius="8dp"
                                    android:layout_alignParentStart="true"
                                    app:cardBackgroundColor="@color/blue_ff"
                                    android:layout_width="wrap_content"
                                    android:layout_marginRight="10dp"
                                    android:layout_height="wrap_content">
                                    <TextView
                                        android:id="@+id/tvStatus"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Status"
                                        android:fontFamily="@font/satoshi_medium"
                                        android:textSize="14sp"/>
                                </androidx.cardview.widget.CardView>
                                <TextView
                                    android:id="@+id/tvTimeStamp"
                                    android:textSize="10sp"
                                    android:layout_centerInParent="true"
                                    android:layout_toRightOf="@+id/cvStatus"
                                    android:textColor="@color/black"
                                    android:fontFamily="@font/satoshi_regular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </RelativeLayout>


                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/rlAction"
                            android:layout_alignParentEnd="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <androidx.cardview.widget.CardView
                                android:layout_width="wrap_content"
                                android:id="@+id/cvDelete"
                                app:cardBackgroundColor="@color/red_e2"
                                android:layout_height="wrap_content"
                                app:contentPadding="8dp"
                                android:foreground="?android:selectableItemBackground"
                                app:cardCornerRadius="12dp"
                                app:cardElevation="0dp">
                                <ProgressBar
                                    android:id="@+id/progressBarDelete"
                                    android:layout_width="24dp"
                                    android:indeterminateTint="@color/red_1b"
                                    android:layout_gravity="center"
                                    android:layout_height="24dp"/>
                                <ImageView
                                    android:id="@+id/btnDelete"
                                    android:src="@drawable/ic_trash"
                                    android:layout_width="24dp"
                                    android:tint="@color/red_1b"
                                    android:layout_gravity="center"
                                    android:layout_height="24dp"/>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                    </RelativeLayout>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        app:cardElevation="0dp"
                        android:layout_marginTop="20dp"
                        android:id="@+id/cvProfile"
                        android:animateLayoutChanges="true"
                        app:cardCornerRadius="12dp"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:orientation="vertical">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icArrowProfileUp"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="20dp"
                                    android:layout_alignParentStart="true"
                                    android:fontFamily="@font/satoshi_medium"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:text="@string/data_pengaju"/>
                                <ImageView
                                    android:id="@+id/icArrowProfileUp"
                                    android:layout_width="24dp"
                                    android:tint="@color/black"
                                    android:layout_centerVertical="true"
                                    android:layout_height="24dp"
                                    android:layout_alignParentEnd="true"
                                    android:src="@drawable/ic_arrow_up"/>
                                <Button
                                    android:id="@+id/btnLayoutProfile"
                                    android:background="@android:color/transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </RelativeLayout>

                            <LinearLayout
                                android:id="@+id/lrContentProfile"
                                android:layout_width="match_parent"
                                android:layout_marginTop="10dp"
                                android:animateLayoutChanges="true"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <View
                                    android:layout_width="match_parent"
                                    android:background="@color/gray_e1"
                                    android:layout_height="1dp"/>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/email"
                                    android:layout_marginTop="20dp"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:inputType="textEmailAddress"
                                        style="@style/text_field_default_style"
                                        android:id="@+id/etEmail"
                                        android:enabled="false"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/nama_lengkap"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etFullName"
                                        android:enabled="false"
                                        style="@style/text_field_default_style"
                                        android:inputType="textPersonName"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/nib"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etNib"
                                        android:enabled="false"
                                        style="@style/text_field_default_style"
                                        android:inputType="number"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/nik"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etNik"
                                        style="@style/text_field_default_style"
                                        android:inputType="number"
                                        android:maxLength="16"
                                        android:enabled="false"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/tempat_lahir"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etTempatLahir"
                                        style="@style/text_field_default_style"
                                        android:inputType="text"
                                        android:enabled="false"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/tgl_lahir"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etTglLahir"
                                        android:focusable="false"
                                        android:enabled="false"
                                        android:clickable="true"
                                        style="@style/text_field_default_style"
                                        android:inputType="text"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/jenis_kelamin"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etJenisKelamin"
                                        style="@style/text_field_default_style"
                                        android:inputType="text"
                                        android:focusable="false"
                                        android:enabled="false"
                                        android:clickable="true"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/Agama"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etAgama"
                                        android:focusable="false"
                                        android:enabled="false"
                                        android:clickable="true"
                                        style="@style/text_field_default_style"
                                        android:inputType="text"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/Pekerjaan"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etPekerjaan"
                                        style="@style/text_field_default_style"
                                        android:inputType="text"
                                        android:enabled="false"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/Kewarganegaraan"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etKewarganegaraan"
                                        style="@style/text_field_default_style"
                                        android:inputType="text"
                                        android:enabled="false"
                                        android:focusable="false"
                                        android:clickable="true"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>
                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/alamat"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etAlamat"
                                        android:lines="5"
                                        android:gravity="start"
                                        android:enabled="false"
                                        style="@style/text_field_default_style"
                                        android:inputType="textMultiLine"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:layout_width="match_parent"
                                    android:hint="@string/no_hp"
                                    android:layout_marginBottom="16dp"
                                    style="@style/text_input_layout_default_style"
                                    android:layout_marginTop="12dp"
                                    android:layout_height="wrap_content">
                                    <com.google.android.material.textfield.TextInputEditText
                                        android:layout_width="match_parent"
                                        android:id="@+id/etNoHp"
                                        android:enabled="false"
                                        style="@style/text_field_default_style"
                                        android:inputType="phone"
                                        android:layout_height="wrap_content"/>
                                </com.google.android.material.textfield.TextInputLayout>
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        app:cardElevation="0dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="60dp"
                        android:id="@+id/cvFilePengajuan"
                        android:animateLayoutChanges="true"
                        app:cardCornerRadius="12dp"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:orientation="vertical">
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_toStartOf="@id/icArrowFileUp"
                                    android:layout_centerVertical="true"
                                    android:layout_marginRight="20dp"
                                    android:layout_alignParentStart="true"
                                    android:fontFamily="@font/satoshi_medium"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:text="@string/berkas_pengajuan"/>
                                <ImageView
                                    android:id="@+id/icArrowFileUp"
                                    android:layout_width="24dp"
                                    android:tint="@color/black"
                                    android:layout_centerVertical="true"
                                    android:layout_height="24dp"
                                    android:layout_alignParentEnd="true"
                                    android:src="@drawable/ic_arrow_up"/>
                                <Button
                                    android:id="@+id/btnLayoutFile"
                                    android:background="@android:color/transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </RelativeLayout>

                            <LinearLayout
                                android:id="@+id/lrContentFile"
                                android:layout_width="match_parent"
                                android:layout_marginTop="10dp"
                                android:animateLayoutChanges="true"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <View
                                    android:layout_width="match_parent"
                                    android:background="@color/gray_e1"
                                    android:layout_height="1dp"/>
                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rvPersyaratan"
                                    android:layout_marginTop="20dp"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>


                    <FrameLayout
                        android:id="@+id/frameSkeleton"
                        android:layout_marginTop="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <include
                            layout="@layout/item_persyaratan_skeleton"/>
                    </FrameLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </LinearLayout>



    </LinearLayout>


    <include
        android:id="@+id/lrEmptyView"
        layout="@layout/empty_state_layout"/>
    <include
        android:id="@+id/lrErrorView"
        layout="@layout/error_state_layout"/>

    <LinearLayout
        android:id="@+id/lrBottom"
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_alignParentBottom="true"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            app:cornerRadius="12dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_marginRight="18dp"
            android:id="@+id/btnReject"
            android:textColor="@color/red_1b"
            android:layout_alignParentEnd="true"
            android:backgroundTint="@color/red_e2"
            android:text="@string/tolak"
            android:fontFamily="@font/satoshi_bold"
            android:textSize="16sp"/>
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            app:cornerRadius="12dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:id="@+id/btnApprove"
            android:textColor="@color/green_34"
            android:layout_alignParentEnd="true"
            android:backgroundTint="@color/green_e7"
            android:text="@string/setuju"
            android:fontFamily="@font/satoshi_bold"
            android:textSize="16sp"/>
    </LinearLayout>



</RelativeLayout>